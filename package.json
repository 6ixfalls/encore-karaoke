{
  "name": "encore-karaoke",
  "version": "1.15.0",
  "description": "Self-hosted karaoke rooms with a browser display and same-origin phone controllers.",
  "type": "module",
  "scripts": {
    "build": "node build-server.mjs",
    "build:server": "npm run build",
    "start": "node server/index.mjs",
    "start:server": "npm start",
    "dev": "npm run build && node --watch server/index.mjs",
    "test": "npm run lint && npm run test:server",
    "test:server": "node --test tests/server/*.test.mjs",
    "lint": "eslint server shared src/hosted src/platform tests/server build-server.mjs eslint.config.js",
    "backup:server": "node server/operations.mjs backup",
    "restore:server": "node server/operations.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Encore-Karaoke-Labs/Encore-Karaoke"
  },
  "keywords": [
    "karaoke",
    "self-hosted",
    "rooms",
    "mp3",
    "lrc"
  ],
  "author": "Encore Karaoke Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Encore-Karaoke-Labs/Encore-Karaoke/issues"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@eslint/js": "^10.0.1",
    "globals": "^17.11.0",
    "eslint": "^10.0.1",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
